SYSTEMAI_DATA_DIR=~/.systemai/runtime
SYSTEMAI_API_HOST=127.0.0.1
SYSTEMAI_API_PORT=8765
SYSTEMAI_AUTONOMY_MODE=standard_auto
SYSTEMAI_ENABLE_PROCESS_MONITOR=false
# SYSTEMAI_PROCESS_MONITOR_INTERVAL_SECONDS=2

# Optional local Ollama models. Leave names blank until the corresponding model is installed.
SYSTEMAI_OLLAMA_URL=http://127.0.0.1:11434
# SYSTEMAI_OLLAMA_SMALL_MODEL=your-small-model:tag
# SYSTEMAI_OLLAMA_TEXT_MODEL=your-text-model:tag
# SYSTEMAI_OLLAMA_VISION_MODEL=your-vision-model:tag
# SYSTEMAI_OLLAMA_EMBEDDING_MODEL=your-embedding-model:tag
# SYSTEMAI_OLLAMA_TIMEOUT_SECONDS=60

# Optional OpenAI Responses text/vision. All values below are required to enable paid calls.
# Verify the chosen model's current prices before setting the conservative input rate.
# The input rate must cover the highest applicable input/cache-write rate; estimates exclude hosted tools.
# SYSTEMAI_ENABLE_OPENAI=true
# OPENAI_API_KEY=
# SYSTEMAI_OPENAI_MODEL=your-responses-compatible-model
# SYSTEMAI_OPENAI_INPUT_USD_PER_MILLION=0
# SYSTEMAI_OPENAI_OUTPUT_USD_PER_MILLION=0
# SYSTEMAI_OPENAI_PRICING_VERIFIED_AT=YYYY-MM-DD
# SYSTEMAI_OPENAI_MAX_INPUT_TOKENS=8192
# SYSTEMAI_OPENAI_MAX_OUTPUT_TOKENS=512
# SYSTEMAI_OPENAI_MAX_TASK_SPEND_USD=0
# SYSTEMAI_OPENAI_MAX_TASK_CALLS=0
# SYSTEMAI_OPENAI_MAX_TASK_VISION_CALLS=0
# SYSTEMAI_OPENAI_TIMEOUT_SECONDS=60

# Optional metered cloud speech, search and image generation.
# Configure positive conservative per-call estimates and enough task/audio budget.
# SYSTEMAI_ENABLE_OPENAI_SPEECH=true
# SYSTEMAI_OPENAI_STT_MODEL=gpt-transcribe
# SYSTEMAI_OPENAI_TTS_MODEL=gpt-4o-mini-tts
# SYSTEMAI_OPENAI_TTS_VOICE=cedar
# SYSTEMAI_OPENAI_STT_MAX_CALL_COST_USD=0
# SYSTEMAI_OPENAI_TTS_MAX_CALL_COST_USD=0
# SYSTEMAI_OPENAI_MAX_TASK_AUDIO_SECONDS=120
# SYSTEMAI_OPENAI_WEB_SEARCH_USD_PER_CALL=0
# SYSTEMAI_OPENAI_IMAGE_MODEL=your-supported-image-model
# SYSTEMAI_OPENAI_IMAGE_MAX_CALL_COST_USD=0

# Holographic workspace: UI 5802, bridge 8787, Python API 8765.
# SYSTEMAI_API_URL=http://127.0.0.1:8765
# SYSTEMAI_BRIDGE_PORT=8787
# SYSTEMAI_MCP_CONFIG=config/mcp.json
# Direct MCP/CDP mutations are disabled; use signed SystemAI tasks.
# Every enabled trusted MCP server needs allowedTools and a positive usdPerCall ceiling.
# SYSTEMAI_CHROME_CDP_URL=http://127.0.0.1:9222
# SYSTEMAI_SPEECH_PROVIDER=openai
# Independent speech providers override the legacy shared setting.
# STT: openai, elevenlabs, deepgram, sarvam. TTS: openai, elevenlabs, cartesia, sarvam.
# SYSTEMAI_STT_PROVIDER=deepgram
# SYSTEMAI_TTS_PROVIDER=cartesia
# DEEPGRAM_API_KEY=
# DEEPGRAM_DIARIZE=true
# DEEPGRAM_MODEL=nova-3
# DEEPGRAM_LANGUAGE=en
# CARTESIA_API_KEY=
# CARTESIA_VOICE_ID=db6b0ed5-d5d3-463d-ae85-518a07d3c2b4
# CARTESIA_MODEL=sonic-3.6
# CARTESIA_LANGUAGE=en
# SARVAM_API_KEY=
# SARVAM_STT_LANGUAGE=unknown
# SARVAM_TTS_LANGUAGE=en-IN
# SARVAM_SPEAKER=shubh_enhi_ads
# Positive conservative call ceilings required; no automatic provider retries.
# Cartesia/Sarvam TTS ceilings apply to 4096/2500 characters, scaled per request.
# Shared task limits use SYSTEMAI_OPENAI_MAX_TASK_* even without OpenAI enabled.
# SYSTEMAI_DEEPGRAM_STT_MAX_CALL_COST_USD=0
# SYSTEMAI_CARTESIA_TTS_MAX_CALL_COST_USD=0
# SYSTEMAI_SARVAM_STT_MAX_CALL_COST_USD=0
# SYSTEMAI_SARVAM_TTS_MAX_CALL_COST_USD=0
# Optional alternative speech provider (credentials remain server-side).
# ELEVENLABS_API_KEY=
# SYSTEMAI_ELEVENLABS_STT_MAX_CALL_COST_USD=0
# SYSTEMAI_ELEVENLABS_TTS_MAX_CALL_COST_USD=0
# JARVIS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
# JARVIS_FILE_ROOTS=/explicit/additional/media/directory
# Set URL/token variables for enabled MCP servers in this private file.
# ZAPIER_MCP_URL=
# PIPEDREAM_MCP_URL=
# GITHUB_TOKEN=
# EXA_MCP_URL=
# SERPER_MCP_URL=
# SERPAPI_MCP_URL=
# HIGGSFIELD_MCP_URL=
# HEYGEN_MCP_URL=
# OPENROUTER_MCP_URL=
# OPENROUTER_IMAGE_MCP_URL=
# PALMIER_MCP_URL=
# ELEVENLABS_MCP_URL=
# ANDROID_MCP_URL=
# LOTTIE_MCP_URL=
# REGISTRY_MCP_URL=
# CLARITY_MCP_URL=

# Desktop control requires the signed CuaDriver.app and user-granted macOS permissions.
SYSTEMAI_ENABLE_DESKTOP=true
SYSTEMAI_DESKTOP_BACKEND=cua-cli
SYSTEMAI_CUA_DRIVER_BINARY=cua-driver
SYSTEMAI_DESKTOP_SESSION=systemai
SYSTEMAI_DESKTOP_ALLOWED_APPS=com.apple.finder,com.apple.TextEdit,com.apple.calculator,com.google.Chrome,com.microsoft.VSCode
# SYSTEMAI_CUA_DRIVER_SOCKET=
# SYSTEMAI_CUA_TIMEOUT_SECONDS=20

# Browser automation uses a dedicated profile, never your personal Chrome profile.
SYSTEMAI_ENABLE_BROWSER=true
SYSTEMAI_BROWSER_HEADLESS=false
SYSTEMAI_BROWSER_CHANNEL=chrome
SYSTEMAI_BROWSER_ALLOWED_ORIGINS=http://127.0.0.1:5802,http://localhost:5802
# SYSTEMAI_BROWSER_PROFILE_DIR=~/.systemai/runtime/browser-profile
# SYSTEMAI_BROWSER_DOWNLOAD_DIR=~/.systemai/runtime/downloads
