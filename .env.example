SYSTEMAI_DATA_DIR=~/.systemai/runtime
SYSTEMAI_API_HOST=127.0.0.1
SYSTEMAI_API_PORT=8765
SYSTEMAI_AUTONOMY_MODE=standard_auto

# Local deterministic planning does not need a cloud API key.
# Only add a provider key if you explicitly enable a model-backed planner.
# OPENAI_API_KEY=

# Desktop control requires the signed CuaDriver.app and user-granted macOS permissions.
SYSTEMAI_ENABLE_DESKTOP=true
SYSTEMAI_DESKTOP_BACKEND=cua-cli
SYSTEMAI_CUA_DRIVER_BINARY=cua-driver
SYSTEMAI_DESKTOP_SESSION=systemai
SYSTEMAI_DESKTOP_ALLOWED_APPS=com.apple.finder,com.apple.TextEdit,com.apple.calculator,com.google.Chrome,com.microsoft.VSCode
# SYSTEMAI_CUA_DRIVER_SOCKET=
# SYSTEMAI_CUA_TIMEOUT_SECONDS=20

# Browser automation uses a dedicated profile, never your personal Chrome profile.
SYSTEMAI_ENABLE_BROWSER=true
SYSTEMAI_BROWSER_HEADLESS=false
SYSTEMAI_BROWSER_CHANNEL=chrome
SYSTEMAI_BROWSER_ALLOWED_ORIGINS=http://127.0.0.1:5802,http://localhost:5802
# SYSTEMAI_BROWSER_PROFILE_DIR=~/.systemai/runtime/browser-profile
# SYSTEMAI_BROWSER_DOWNLOAD_DIR=~/.systemai/runtime/downloads
