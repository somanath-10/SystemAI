SYSTEMAI_VERSION=1.0.0
SYSTEMAI_DATA_DIR=~/.systemai/v1
SYSTEMAI_API_HOST=127.0.0.1
SYSTEMAI_API_PORT=8765
SYSTEMAI_AUTONOMY_MODE=standard_auto

# V1 uses local deterministic developer diagnosis by default.
# Remote/model providers are optional future/pluggable paths and are not required.
# OPENAI_API_KEY=

# V2 forward-compatible desktop settings (disabled by default in V1 release scope)
SYSTEMAI_ENABLE_DESKTOP=false
SYSTEMAI_DESKTOP_BACKEND=cua-cli
SYSTEMAI_CUA_DRIVER_BINARY=cua-driver
SYSTEMAI_DESKTOP_SESSION=systemai

# V2 browser integration (disabled by default)
SYSTEMAI_ENABLE_BROWSER=false
SYSTEMAI_BROWSER_HEADLESS=false
